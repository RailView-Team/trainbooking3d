# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railway_db?schema=public"

# Server
PORT=3000

# JWT
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="1d"

# Train location simulation interval, in milliseconds.
# 10000 = 10 seconds (good for demoing in development)
TRAIN_LOCATION_INTERVAL=10000
